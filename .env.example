# Aeon Forge bot environment
# On the Beast, .env is a symlink to /etc/stixed/secrets/aeon-forge-bot.env.
# Everything else (collections, channels, switches, company wallets) lives in the database.

# Forge Bot token (https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Alchemy key; its app must have Base Mainnet and Base Sepolia enabled
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Postgres password, shared by the bot and the postgres container
# Generate with: openssl rand -base64 32
DB_PASSWORD=your_secure_random_password_here

# Optional: DEBUG, INFO, WARNING, ERROR, CRITICAL (default INFO)
# LOG_LEVEL=INFO
